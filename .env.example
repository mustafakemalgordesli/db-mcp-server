# Database Provider Configuration
# Supported providers: sqlite, postgresql, mysql, mssql

# You can define multiple databases using a JSON string:
# DATABASES='{"default": {"provider": "sqlite", "connection_string": "sqlite:///data.db"}, "secondary": {"provider": "postgresql", "connection_string": "postgresql://user:password@localhost/mydb"}}'

# Or use the single fallback configuration:
DB_PROVIDER=sqlite
DB_CONNECTION_STRING=sqlite:///data.db

# PostgreSQL example:
# DB_PROVIDER=postgresql
# DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/mydb

# MySQL example:
# DB_PROVIDER=mysql
# DB_CONNECTION_STRING=mysql+pymysql://user:password@localhost:3306/mydb

# SQL Server example:
# DB_PROVIDER=mssql
# DB_CONNECTION_STRING=mssql+pyodbc://user:password@localhost:1433/mydb?driver=ODBC+Driver+17+for+SQL+Server

# MCP Server Configuration (only applies if transport is sse or streamable-http)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=9001
MCP_SERVER_PATH=/mcp

# Authentication (only applies if transport is sse or streamable-http)
# Set to require an API Key for incoming requests. Clients must send the key 
# via the "X-API-Key" header or "Authorization: Bearer <key>" header.
# API_KEY=your_secret_api_key_here
